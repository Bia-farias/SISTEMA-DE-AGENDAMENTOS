# ==============================================================================
# AGENDA AI BACKEND — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# Porta do Servidor Express
PORT=3001

# URL do PostgreSQL (Prisma ORM)
# Para Supabase: postgresql://postgres:[SUA_SENHA]@db.wbvnifdtozhgwaclldac.supabase.co:5432/postgres?sslmode=require
# Para PostgreSQL Local: postgresql://postgres:postgres@localhost:5432/agenda_ai?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenda_ai?schema=public

# Chave Secreta para Assinatura de Tokens JWT (Use uma string segura)
JWT_SECRET=agenda_ai_jwt_secret_token_key_dev_2026_super_secure!
JWT_EXPIRES_IN=7d

# URL do Frontend React permitida pelo CORS
FRONTEND_URL=http://localhost:5173
