# ==========================================
# AGENDA AI - VARIÁVEIS DE AMBIENTE (.env)
# ==========================================

# Configurações do Supabase (BaaS / PostgreSQL)
# Obtenha estas credenciais no painel do seu projeto no Supabase: https://supabase.com
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# Configurações da Groq (Assistente de Inteligência Artificial com Llama 3.3)
# Opcional: Se não for preenchida, o sistema executa automaticamente em modo de simulação inteligente.
# Obtenha gratuitamente em: https://console.groq.com
VITE_GROQ_API_KEY=gsk_sua_chave_groq_aqui
